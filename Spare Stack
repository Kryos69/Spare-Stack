local executor = identifyexecutor and identifyexecutor() or "Unknown"

if executor:lower():find("solara") or executor:lower():find("xeno") then
    game.Players.LocalPlayer:Kick("Spare Stack doesn't support shitsploits 😭")
    return
end

local gameId = game.GameId

if gameId == 1234567890 then
    loadstring(game:HttpGet(""))()

elseif gameId == 9876543210 then
    loadstring(game:HttpGet(""))()

elseif gameId == 5555555555 then
    loadstring(game:HttpGet(""))()

else
    game.Players.LocalPlayer:Kick("Spare Stack doesn't support this game.")
end
